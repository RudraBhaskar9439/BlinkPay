# Public RPC URLs. Replace these with a dedicated provider before production.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_NETWORK=testnet
NEXT_PUBLIC_BLINKPAY_ROUTER_ADDRESS=
NEXT_PUBLIC_BLINKPAY_TESTNET_POOL_ADDRESS=

# Server-only 0x credentials and deployment-matched allowlists. Never prefix the
# API key with NEXT_PUBLIC and never commit a real value.
ZEROX_API_KEY=
ZEROX_SWAP_TARGET=
ZEROX_SWAP_SELECTORS=

# Server-only AI preference compiler. xAI takes priority when both providers are
# configured. Never prefix keys with NEXT_PUBLIC and never commit real values.
# Without a provider key, BlinkPay uses its deterministic parser.
XAI_API_KEY=
XAI_POLICY_MODEL=grok-4.3
OPENAI_API_KEY=
OPENAI_POLICY_MODEL=gpt-5.6-luna
